{
  "schema_id": "mtfs-storage-sentinel-model-input",
  "version": 1,
  "dimension": 24,
  "integer_encoder": "portable-u64-v1",
  "missing_policy": "reject_frame",
  "normalization": "target_specific_zscore_clamped_to_8",
  "quantization": {
    "normalization_mean": "Q16.16",
    "normalization_inverse_std": "Q12.20",
    "model_input": "signed_int8_zscore_times_16"
  },
  "validity": {
    "required_mask": 255,
    "rejected_flag_mask": 31,
    "minimum_timing_samples_per_operation": 1,
    "hard_fault_columns_must_be_zero": true
  },
  "features": [
    {"name":"read_avg_latency_us","unit":"us","min":0,"max":1000000,"reason":"central read latency"},
    {"name":"read_timing_invalid_permille","unit":"permille","min":0,"max":1000,"reason":"read timing quality"},
    {"name":"read_hist_0_3_permille","unit":"permille","min":0,"max":1000,"reason":"fast read distribution mass"},
    {"name":"read_hist_4_7_permille","unit":"permille","min":0,"max":1000,"reason":"lower read distribution mass"},
    {"name":"read_hist_8_11_permille","unit":"permille","min":0,"max":1000,"reason":"middle read distribution mass"},
    {"name":"read_hist_12_14_permille","unit":"permille","min":0,"max":1000,"reason":"read tail mass"},
    {"name":"read_hist_15_permille","unit":"permille","min":0,"max":1000,"reason":"extreme read tail mass"},
    {"name":"write_avg_latency_us","unit":"us","min":0,"max":1000000,"reason":"central write latency"},
    {"name":"write_timing_invalid_permille","unit":"permille","min":0,"max":1000,"reason":"write timing quality"},
    {"name":"write_hist_0_3_permille","unit":"permille","min":0,"max":1000,"reason":"fast write distribution mass"},
    {"name":"write_hist_4_7_permille","unit":"permille","min":0,"max":1000,"reason":"lower write distribution mass"},
    {"name":"write_hist_8_11_permille","unit":"permille","min":0,"max":1000,"reason":"middle write distribution mass"},
    {"name":"write_hist_12_14_permille","unit":"permille","min":0,"max":1000,"reason":"write tail mass"},
    {"name":"write_hist_15_permille","unit":"permille","min":0,"max":1000,"reason":"extreme write tail mass"},
    {"name":"sync_avg_latency_us","unit":"us","min":0,"max":1000000,"reason":"central sync latency"},
    {"name":"sync_timing_invalid_permille","unit":"permille","min":0,"max":1000,"reason":"sync timing quality"},
    {"name":"sync_hist_0_3_permille","unit":"permille","min":0,"max":1000,"reason":"fast sync distribution mass"},
    {"name":"sync_hist_4_7_permille","unit":"permille","min":0,"max":1000,"reason":"lower sync distribution mass"},
    {"name":"sync_hist_8_11_permille","unit":"permille","min":0,"max":1000,"reason":"middle sync distribution mass"},
    {"name":"sync_hist_12_14_permille","unit":"permille","min":0,"max":1000,"reason":"sync tail mass"},
    {"name":"sync_hist_15_permille","unit":"permille","min":0,"max":1000,"reason":"extreme sync tail mass"},
    {"name":"read_timing_share_permille","unit":"permille","min":0,"max":1000,"reason":"read/write/sync relationship"},
    {"name":"write_timing_share_permille","unit":"permille","min":0,"max":1000,"reason":"read/write/sync relationship"},
    {"name":"sync_timing_share_permille","unit":"permille","min":0,"max":1000,"reason":"read/write/sync relationship"}
  ],
  "excluded": [
    "target", "transport", "timestamp_us", "media_generation", "sequence",
    "label", "marker", "build_type", "command", "scenario_origin", "stage",
    "severity", "injection_kind", "injection_operation_mask",
    "injection_rate_permille", "requested_delay_us", "actual_injection_count",
    "random_seed", "cumulative_or_hard_fault_counters"
  ]
}
